# ── Server ────────────────────────────────────────────────────────
PORT=3000

# AI providers (optional — the app falls back to a built-in offline engine)
# Resolution order: values saved in Settings UI → these env vars → offline mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Frontend dev server (vite) proxies /api to the API ───────────
